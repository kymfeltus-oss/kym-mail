# Public Supabase project values. Safe for the browser; database access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional server log threshold: debug | info | warn | error
LOG_LEVEL=info

# Local development convenience only. Production always ignores this flag.
KYM_DEV_AUTH_BYPASS=false
# The owner email is required only for the bypass. The service-role key is also used by
# server-only OAuth and webhook routes; it must never use a NEXT_PUBLIC_ prefix.
KYM_DEV_OWNER_EMAIL=owner@example.com
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Gate 2 Google Mail integration (all server-only except the application URL).
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/kym-mail-gmail
GMAIL_PUBSUB_PUSH_SERVICE_ACCOUNT=kym-mail-pubsub-push@your-project.iam.gserviceaccount.com
GMAIL_PUBSUB_AUDIENCE=https://your-domain.example/api/webhooks/gmail
OAUTH_STATE_SECRET=generate-a-long-random-value
MAIL_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
APP_URL=http://localhost:3000

# Gate 4 production scheduler. Server-only; Vercel sends it as a Bearer token to cron routes.
CRON_SECRET=generate-a-random-value-of-at-least-32-characters

# Gate 5 Adzuna Job Search. Server-only; register at https://developer.adzuna.com/.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Gate 9 Apollo contact intelligence. Server-only. The key needs access to
# organization enrichment, People API Search, and People Enrichment.
APOLLO_API_KEY=
